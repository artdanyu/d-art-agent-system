# Токен бота-консультанта (@BotFather). Не публикуйте в репозиторий.
TELEGRAM_BOT_TOKEN=

# Бекенд на том же сервере: оставьте 127.0.0.1 (бот стучится на localhost).
BACKEND_URL=http://127.0.0.1:3000

# Тот же ключ, что API_KEY в backend/.env (если задан на бекенде).
BACKEND_API_KEY=

AGENT_ID=default
