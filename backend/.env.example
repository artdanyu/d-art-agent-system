PORT=3000
BIND_ADDRESS=0.0.0.0
NODE_ENV=development

# Required for AI (server only — never expose to browsers)
DEEPSEEK_API_KEY=

DATABASE_PATH=./data/app.db

# Промпты по клиентам: папки в agent_system/backend/clients/ (см. clients/HOWTO.txt).
# 1 = читать system.md с диска на каждый запрос (отладка). В проде обычно 0 — хватает синка при старте.
# CLIENT_PROMPTS_HOT_RELOAD=0

# Comma-separated allowlist. In production must NOT be * (server refuses to start).
# Пример: https://yourdomain.com,http://78.111.91.118
CORS_ORIGIN=http://127.0.0.1:5500,https://yourdomain.com,http://78.111.91.118

# Shared secret for Telegram bot / server-to-server calls. Browsers must NOT embed this.
# When set: requests need X-API-Key OR (source=web + Turnstile below).
API_KEY=

# Production without API_KEY: explicit opt-in only (not recommended without Turnstile + strict limits).
# ALLOW_ANONYMOUS_ACCESS=1

# Cloudflare Turnstile (secret from dashboard) — required for public web widget when API_KEY is set.
# Send turnstileToken in JSON body from the widget.
# TURNSTILE_SECRET_KEY=

# Behind nginx / Cloudflare — trust X-Forwarded-For for IP limits
TRUST_PROXY=1

# JSON body size (chat + lead)
JSON_BODY_LIMIT=128kb

# Rate limits (IP + fingerprint)
# RATE_LIMIT_IP_PER_MIN=30
# RATE_LIMIT_IP_PER_HOUR=200
# RATE_LIMIT_FINGERPRINT_PER_MIN=20

# Chat pacing & abuse (see violations.js)
# CHAT_MIN_INTERVAL_MS=1400
# CHAT_MAX_DUP_STREAK=5
# CHAT_MAX_MESSAGE_CHARS=6000
# DEEPSEEK_MAX_TOKENS=1200
# AUTO_LIMIT_VIOLATIONS=10
# AUTO_BLOCK_VIOLATIONS=25

# Block external user ids (comma-separated)
# BLOCKED_EXTERNAL_IDS=

# Уведомления о лидах в Telegram (форма сайта + захват контакта из чата).
# Токен бота — @BotFather. Один бот; разные чаты — см. ниже.
TELEGRAM_NOTIFY_BOT_TOKEN=
# Резервный / общий чат (если нет маппинга по агенту)
TELEGRAM_NOTIFY_CHAT_ID=589807721
# Опционально: JSON — куда слать заявки по data-agent-id (клиент 123okna → его chat_id)
# TELEGRAM_NOTIFY_BY_AGENT={"default":"589807721","123okna":"ВАШ_ID_КЛИЕНТА"}
# Либо clients/<агент>/notify.json — см. clients/123okna/notify.json.example

# Dev-only Yandex test script (test-yandex.js)
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
